# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit it, never paste its contents into
# chat. Next.js loads it automatically; nothing else needs to change.

# From https://resend.com/api-keys — looks like re_XXXXXXXX_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_API_KEY=

# Who the pre-order email is FROM. Must be on a domain you've verified in
# Resend's dashboard (Domains -> Add Domain -> veggiematefoodtruck.au).
# Until that's done, leave this unset — the code falls back to Resend's own
# sandbox address (onboarding@resend.dev), which works with no setup at all,
# so you can test the whole flow before your domain is verified.
ORDER_FROM_EMAIL=

# Who receives the pre-order. Defaults to the address in src/lib/site.ts if
# unset — override here once you know which inbox should actually get these.
ORDER_TO_EMAIL=
